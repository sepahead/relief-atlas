#!/bin/sh
# Works from Finder, any terminal directory, and without activating an env.
set -eu
atlas_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for atlas_python in \
    "$atlas_root/meshmaker/local/imgenv/bin/python" \
    "$atlas_root/meshmaker/local/trellis-mac/.venv/bin/python" \
    /opt/homebrew/bin/python3 /usr/bin/python3
do
    if [ -x "$atlas_python" ] && "$atlas_python" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
        exec "$atlas_python" "$atlas_root/scripts/local/offline_run.py" "$@"
    fi
done
echo "Atlas needs the existing Python 3.10+ environment. No packages were installed or downloaded." >&2
exit 1
